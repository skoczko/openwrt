#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ "$ACTION" = "released" ] || exit 0

. /lib/functions.sh

[ "$(board_name)" = "netgear,readynas-duo-v2" ] || exit 0

# The power button shares its GPIO with the Ethernet PHY interrupt.
# Require a deliberate hold to ignore short pulses from PHY resets.
case "$SEEN" in
	''|*[!0-9]*) exit 0 ;;
esac
[ "$SEEN" -ge 3 ] || exit 0

logger -t power-button "Power button held for ${SEEN}s; shutting down"
exec /sbin/poweroff
